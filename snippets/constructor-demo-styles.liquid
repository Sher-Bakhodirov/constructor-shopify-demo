{% doc %}
  Visual layer matching the Constructor React reference storefront
  (constructorio-example-data-driven-tracking): stone palette, centered product
  cards with a dark full-width "Add to Cart" button, pill search input, a nav row
  under the header and a quiet footer.

  Constructor's UI libraries inject their own CSS at runtime (after this file), so
  overrides for `.cio-*` markup are scoped under the theme mount containers to win
  on specificity.

  Rendered once from `layout/theme.liquid`.
{% enddoc %}

{% stylesheet %}
  :root {
    --demo-stone-50: #fafaf9;
    --demo-stone-100: #f5f5f4;
    --demo-stone-200: #e7e5e4;
    --demo-stone-300: #d6d3d1;
    --demo-stone-400: #a8a29e;
    --demo-stone-500: #78716c;
    --demo-stone-600: #57534e;
    --demo-stone-800: #292524;
    --demo-stone-900: #1c1917;
    --demo-gray-900: #111827;
    --demo-gray-800: #1f2937;
    --demo-blue-700: #1d4ed8;
    --demo-red-500: #ef4444;
    --demo-green-600: #16a34a;
    --demo-radius: 0.5rem;
    --demo-radius-xl: 0.75rem;
    --demo-radius-3xl: 1.5rem;
    --demo-shadow-card: 0 1px 3px rgb(0 0 0 / 0.1), 0 1px 2px rgb(0 0 0 / 0.06);
    --demo-shadow-popover: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -2px rgb(0 0 0 / 0.05);
  }

  /* ---------- Shared product card (demo ProductCard) ---------- */

  .demo-card-title,
  .cnstrc-card__title {
    font-weight: 500;
    color: var(--demo-gray-900);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cnstrc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-align: center;
    transition: opacity 150ms ease;
  }

  .cnstrc-card:hover {
    opacity: 0.8;
  }

  .cnstrc-card__link {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    color: inherit;
    text-decoration: none;
  }

  .cnstrc-card__media {
    height: 225px;
    margin-bottom: 0.25rem;
  }

  .cnstrc-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cnstrc-card__title {
    margin-bottom: 0.25rem;
  }

  .cnstrc-card__price {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--demo-gray-900);
    margin-bottom: 0.5rem;
  }

  .cnstrc-card__atc {
    width: 100%;
    margin-top: auto;
  }

  /* Native Horizon product cards pick up the same centered, bold-price look. */
  .product-card {
    text-align: center;
  }

  .product-card .price {
    font-weight: 700;
    color: var(--demo-gray-900);
  }

  /* ---------- Constructor PLP (search + collections) ---------- */

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp {
    color: var(--demo-stone-800);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-plp-grid {
    grid-template-columns: 200px 1fr;
    gap: 1.25rem;
    padding: 0;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-filters-container {
    padding: 0.5rem;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-filter-header {
    font-size: 1rem;
    font-weight: 700;
    border-bottom: none;
    padding-bottom: 0.25rem;
    margin-bottom: 0.25rem;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-filter-option-label {
    font-size: 0.9375rem;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-filter-option-count {
    color: var(--demo-stone-400);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-products-header-wrapper {
    padding: 0 0 1.5rem;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-products-header-title {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 500;
    color: var(--demo-stone-800);
    text-align: start;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-plp-sort .collapsible {
    min-width: 180px;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--demo-stone-200);
    border-radius: var(--demo-radius);
    font-size: 1rem;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-plp-sort .collapsible-content {
    margin-top: 0.25rem;
    border: 1px solid var(--demo-stone-200);
    border-radius: var(--demo-radius);
    box-shadow: var(--demo-shadow-popover);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-product-tiles-container {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    column-gap: 1.5rem;
    row-gap: 1.5rem;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-product-tile {
    padding: 0;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-product-card {
    text-align: center;
    transition: opacity 150ms ease;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-product-card:hover {
    opacity: 0.8;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-image-container {
    height: 225px;
    margin-bottom: 0.25rem;
    overflow: hidden;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-item-prices-container {
    justify-content: center;
    order: 2;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-item-name {
    order: 1;
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--demo-gray-900);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-item-price {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: normal;
    color: var(--demo-gray-900);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-item-price.cio-item-price-strikethrough {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--demo-stone-400);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-add-to-cart-button {
    height: auto;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: var(--demo-radius);
    background-color: var(--demo-gray-900);
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    transition: background-color 150ms ease;
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-add-to-cart-button:hover {
    background-color: var(--demo-gray-800);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-pagination a,
  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-pagination button {
    border: 1px solid var(--demo-stone-200);
    border-radius: var(--demo-radius);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-pagination a.selected,
  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-pagination button.selected {
    background-color: var(--demo-stone-900);
    border-color: var(--demo-stone-900);
  }

  :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-filters-modal-button {
    border: 2px solid var(--demo-stone-200);
    border-radius: var(--demo-radius);
  }

  @media (max-width: 768px) {
    :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-plp-grid {
      grid-template-columns: 1fr;
    }

    :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-product-tiles-container {
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }

    :is(.constructor-plp, [data-block-handle="plp"]) .cio-plp .cio-products-header-title {
      text-align: center;
    }
  }

  /* ---------- Constructor recommendations ---------- */

  .constructor-recommendations .cio-pod-header {
    margin-bottom: 1.5rem;
  }

  .constructor-recommendations .cio-pod-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1f2937;
  }

  .constructor-recommendations .cio-pod-subtitle {
    color: var(--demo-stone-500);
  }

  .constructor-recommendations .cio-product-card.cio-product-card {
    max-width: none;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    text-align: center;
    transition: opacity 150ms ease;
  }

  .constructor-recommendations .cio-product-card.cio-product-card:hover {
    opacity: 0.8;
  }

  .constructor-recommendations .cio-product-card .cio-product-card-image {
    height: 225px;
    min-height: 0;
    border-radius: 0;
  }

  .constructor-recommendations .cio-product-card .cio-product-card-content {
    align-items: center;
  }

  .constructor-recommendations .cio-product-card .cio-product-card-title-section {
    font-weight: 500;
    color: var(--demo-gray-900);
  }

  .constructor-recommendations .cio-product-card .cio-product-card-price-section {
    justify-content: center;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--demo-gray-900);
  }

  .constructor-recommendations .cio-product-card .cio-product-card-add-to-cart-btn {
    padding-block: 0.5rem;
    border-radius: var(--demo-radius);
    background-color: var(--demo-gray-900);
    font-size: 1rem;
    font-weight: 600;
  }

  .constructor-recommendations .cio-product-card .cio-product-card-add-to-cart-btn:hover {
    background-color: var(--demo-gray-800);
  }

  .constructor-recommendations .cio-product-card .cio-product-card-wishlist-btn {
    inset-inline: 0.5rem auto;
    top: 0.5rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  /* ---------- Constructor autocomplete (search modal) ---------- */

  .cnstrc-ac__form {
    gap: 0;
  }

  .cnstrc-ac__input {
    padding: 0.5rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: var(--demo-radius) 0 0 var(--demo-radius);
    background: #fff;
    color: #374151;
  }

  .cnstrc-ac__input:focus {
    outline: none;
    border-color: transparent;
    box-shadow: 0 0 0 2px #3b82f6;
  }

  .cnstrc-ac__submit.button {
    padding: 0.5rem 1rem;
    border-radius: 0 var(--demo-radius) var(--demo-radius) 0;
    background-color: #2563eb;
    color: #fff;
  }

  .cnstrc-ac__submit.button:hover {
    background-color: var(--demo-blue-700);
  }

  .cnstrc-ac__dropdown {
    top: calc(100% + 0.25rem);
    padding: 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: var(--demo-radius);
    box-shadow: var(--demo-shadow-popover);
  }

  .cnstrc-ac__heading {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
  }

  @media screen and (min-width: 750px) {
    .cnstrc-ac__grid {
      gap: 0;
    }

    .cnstrc-ac__section--suggestions {
      padding-inline-end: 0.75rem;
      border-inline-end: 1px solid #f3f4f6;
    }

    .cnstrc-ac__section--products {
      padding-inline-start: 0.75rem;
    }
  }

  .cnstrc-ac__suggestion a {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: #1f2937;
  }

  .cnstrc-ac__suggestion a:hover,
  .cnstrc-ac__product a:hover {
    background: #f3f4f6;
  }

  .cnstrc-ac__products {
    gap: 0.5rem;
  }

  .cnstrc-ac__product a {
    align-items: center;
    padding: 0.5rem;
    border-radius: 0.25rem;
  }

  .cnstrc-ac__product img {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    background: transparent;
  }

  .cnstrc-ac__product-title {
    font-size: 0.75rem;
    color: #1f2937;
  }

  .cnstrc-ac__product-price {
    font-size: 0.75rem;
    color: #4b5563;
  }

  /* ---------- Header nav row (demo MainNavbar) ---------- */

  .header__row--bottom .menu-list__link {
    color: #374151;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .header__row--bottom .menu-list__link:hover,
  .header__row--bottom .menu-list__link--active {
    color: var(--demo-blue-700);
  }

  .header__row--bottom .menu-list__link--active {
    color: darkblue;
  }
{% endstylesheet %}
