{% comment %}
  "Shop by Category" grid from the Constructor React reference storefront: bordered
  text tiles with an underline that grows on hover. Falls back to the store's first
  collections when none are picked.
{% endcomment %}

{%- liquid
  assign collection_list = section.settings.collection_list
  if collection_list == blank
    assign collection_list = collections
  endif
-%}

<div
  class="section section--page-width spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="demo-categories">
    <div class="demo-categories__header">
      <h2 class="demo-categories__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="demo-categories__view-all" href="{{ routes.collections_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="demo-categories__grid">
      {%- for collection in collection_list limit: section.settings.max_items -%}
        <a class="demo-categories__tile" href="{{ collection.url }}">
          <span class="demo-categories__label">{{ collection.title }}</span>
          <span class="demo-categories__underline" aria-hidden="true"></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .demo-categories__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .demo-categories__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    color: var(--demo-stone-800, #292524);
  }

  .demo-categories__view-all {
    font-size: 0.875rem;
    color: var(--demo-stone-500, #78716c);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .demo-categories__view-all:hover {
    color: var(--demo-stone-800, #292524);
  }

  .demo-categories__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media screen and (min-width: 768px) {
    .demo-categories__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .demo-categories__tile {
    position: relative;
    display: block;
    padding: 2.5rem 1.5rem;
    text-align: center;
    text-decoration: none;
    background-color: #fff;
    border: 1px solid var(--demo-stone-200, #e7e5e4);
    border-radius: var(--demo-radius, 0.5rem);
    transition: all 300ms ease;
  }

  .demo-categories__tile:hover {
    border-color: var(--demo-stone-900, #1c1917);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }

  .demo-categories__label {
    font-weight: 500;
    letter-spacing: 0.025em;
    color: var(--demo-stone-600, #57534e);
    transition: color 300ms ease;
  }

  .demo-categories__tile:hover .demo-categories__label {
    color: var(--demo-stone-900, #1c1917);
  }

  .demo-categories__underline {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--demo-stone-900, #1c1917);
    transform: translateX(-50%);
    transition: width 300ms ease;
  }

  .demo-categories__tile:hover .demo-categories__underline {
    width: 50%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo category grid",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum collections",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Demo category grid"
    }
  ]
}
{% endschema %}
